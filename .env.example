# Organisation API key from app.keeperhub.com → avatar → API Keys → Organisation.
# Prefix is kh_. Never commit the real value. User keys (wfb_) will not work.
KEEPERHUB_API_KEY=kh_your_org_key_here

# Policy (packages/policy). Execute is blocked when KILL_SWITCH=1.
KILL_SWITCH=0
POLICY_MAX_USDS=10
POLICY_CHAIN_ID=1
POLICY_COOLDOWN_SECONDS=30

# Optional override. Default is the hosted MCP.
KEEPERHUB_MCP_URL=https://app.keeperhub.com/mcp
KEEPERHUB_API_URL=https://app.keeperhub.com
